<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">@Message</MudText>

        @if (Items.Count > 0)
        {
            <MudPaper Outlined="true" Class="pa-2 mb-3" Style="max-height: 280px; overflow-y: auto;">
                <MudList T="string" Dense="true" Class="py-0">
                    @foreach (var item in Items)
                    {
                        <MudListItem T="string"
                                     Icon="@Icons.Material.Filled.FiberManualRecord"
                                     IconSize="Size.Small"
                                     Text="@item" />
                    }
                </MudList>
            </MudPaper>
        }

        @if (!string.IsNullOrWhiteSpace(Warning))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-3">
                @Warning
            </MudAlert>
        }

        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            This cannot be undone. Deletion may take several seconds per item.
        </MudAlert>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="OnCancel">Cancel</MudButton>
        <MudButton Color="Color.Error"
                   Variant="Variant.Filled"
                   StartIcon="@ConfirmIcon"
                   OnClick="OnConfirm">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public string Message { get; set; } = "Delete the following item(s)?";
    [Parameter] public IReadOnlyList<string> Items { get; set; } = Array.Empty<string>();

    /// <summary>Confirm-button label. Defaults to "Delete" so existing call sites are unchanged.</summary>
    [Parameter] public string ConfirmText { get; set; } = "Delete";
    [Parameter] public string ConfirmIcon { get; set; } = Icons.Material.Filled.Delete;

    /// <summary>Optional extra warning shown above the standard one — for consequences specific to this
    /// action that the generic "cannot be undone" line doesn't cover.</summary>
    [Parameter] public string? Warning { get; set; }

    private void OnCancel()  => Dialog.Cancel();
    private void OnConfirm() => Dialog.Close(DialogResult.Ok(true));
}
