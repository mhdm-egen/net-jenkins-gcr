@page "/jenkins/builds"
@inject IBuildStore Store
@inject JenkinsApiClient Api
@inject JenkinsOptions JenkinsOpts
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Jenkins — Builds</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Builds</MudText>
    <MudSelect T="Guid?" Value="@_selectedPipelineId" ValueChanged="OnPipelineSelectedAsync"
               Label="Pipeline" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
               Disabled="@(_pipelines.Count == 0)"
               Style="max-width: 16rem;">
        @foreach (var p in _pipelines)
        {
            <MudSelectItem T="Guid?" Value="@p.Id">@p.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSpacer />
    <MudNumericField T="int"
                     @bind-Value="_count"
                     Min="5"
                     Max="200"
                     Step="5"
                     Label="Show last"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Style="max-width: 9rem;" />
    <RefreshControls Loading="@_loading"
                     AutoRefreshOn="@_autoOn"
                     LastFetchedAt="@_lastFetchedAt"
                     IntervalSec="@IntervalSec"
                     OnRefresh="RefreshAsync"
                     OnToggleAuto="ToggleAuto" />
</MudStack>

@if (_error is { Length: > 0 })
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-2">@_error</MudAlert>
}

@if (_pipelines.Count == 0 && !_loading)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-2">
        No pipelines are defined, so this page is showing the default <code>@FallbackJob</code> job.
        Define one under <MudLink Href="/jenkins/pipelines">Jenkins → Pipelines</MudLink> to pick
        which jobs appear here.
    </MudAlert>
}

<MudTextField @bind-Value="_filter"
              Placeholder="Filter by version, build #, or status…"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              IconSize="Size.Small"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Clearable="true"
              Immediate="true"
              Class="mb-3"
              Style="max-width: 28rem;" />

@if (_loading && _runs.Count == 0 && _errors.Count == 0)
{
    <MudProgressLinear Indeterminate="true" />
}

<MudExpansionPanels MultiExpansion="true" Elevation="1">
    @foreach (var job in _stageJobs)
    {
        var rows = VisibleRows(job);
        <MudExpansionPanel Expanded="@_expanded.Contains(job)"
                           ExpandedChanged="@(v => SetExpanded(job, v))">
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.body1">@job</MudText>
                    @if (_errors.ContainsKey(job))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">
                            unavailable
                        </MudChip>
                    }
                    else if (_runs.TryGetValue(job, out var loaded))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @(HasFilter ? $"{rows.Count} of {loaded.Count}" : rows.Count.ToString())
                        </MudChip>
                    }
                </MudStack>
            </TitleContent>
            <ChildContent>
                @if (_errors.TryGetValue(job, out var err))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        Could not read runs of <code>@job</code> from Jenkins: @err
                    </MudAlert>
                }
                else if (!_runs.ContainsKey(job))
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (rows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                        @(HasFilter ? "No runs match the filter." : "No builds. Refresh to fetch.")
                    </MudText>
                }
                else
                {
                    <MudTable Items="@rows" Dense="true" Hover="true" Striped="true" T="Build">
                        <HeaderContent>
                            <MudTh Style="width: 5rem;">#</MudTh>
                            <MudTh>Version</MudTh>
                            <MudTh Style="width: 8rem;">Status</MudTh>
                            <MudTh Style="width: 11rem;">Started</MudTh>
                            <MudTh Style="width: 7rem;">Duration</MudTh>
                            <MudTh Style="width: 8rem; text-align: right;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="font-family: ui-monospace, monospace;">#@context.Number</MudTd>
                            <MudTd>@(context.Description ?? "—")</MudTd>
                            <MudTd>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@StatusColor(context)"
                                         Variant="Variant.Filled">
                                    @StatusLabel(context)
                                </MudChip>
                            </MudTd>
                            <MudTd>@FormatStarted(context.Timestamp)</MudTd>
                            <MudTd>@FormatDuration(context)</MudTd>
                            <MudTd Style="text-align: right; white-space: nowrap;">
                                <MudTooltip Text="View summary">
                                    <MudIconButton Icon="@Icons.Material.Filled.Info"
                                                   Size="Size.Small"
                                                   OnClick="@(() => Nav.NavigateTo(DetailLinkFor(job, context)))" />
                                </MudTooltip>
                                <MudTooltip Text="Open in Jenkins">
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                   Size="Size.Small"
                                                   Href="@JenkinsLinkFor(job, context)"
                                                   Target="_blank" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new[] { 25, 50, 100, 200 }" />
                        </PagerContent>
                    </MudTable>
                }
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    public const int IntervalSec = 30;

    /// <summary>
    /// Used only when no pipelines are defined, so the page still shows something rather than a
    /// blank panel list. This was the page's hardcoded job before it grew a pipeline selector.
    /// </summary>
    private const string FallbackJob = "cicd-build";

    private int _count = 25;
    private bool _loading;
    private bool _autoOn;
    private string? _error;
    private DateTimeOffset? _lastFetchedAt;
    private string _filter = string.Empty;
    private CancellationTokenSource? _inflightCts;
    private Timer? _timer;
    private int _lastFetchedCount;

    private IReadOnlyList<PipelineSummaryDto> _pipelines = Array.Empty<PipelineSummaryDto>();
    private Dictionary<Guid, IReadOnlyList<string>> _pipelineJobs = new();
    private Guid? _selectedPipelineId;

    private IReadOnlyList<string> _stageJobs = Array.Empty<string>();
    private readonly Dictionary<string, IReadOnlyList<Build>> _runs = new();
    private readonly Dictionary<string, string> _errors = new();
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);

    private bool HasFilter => !string.IsNullOrWhiteSpace(_filter);

    protected override async Task OnInitializedAsync()
    {
        await LoadPipelinesAsync();
        await RefreshAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Refetch when the user changes the count, but only if the value actually changed.
        if (_count != _lastFetchedCount && !_loading)
        {
            await RefreshAsync();
        }
    }

    private async Task LoadPipelinesAsync()
    {
        try { _pipelines = await Api.ListPipelinesAsync(); }
        catch (Exception ex) { _pipelines = Array.Empty<PipelineSummaryDto>(); _error = ex.Message; }

        // Fetch each pipeline's stage jobs in declared order — there are only a handful of pipelines.
        var jobs = new Dictionary<Guid, IReadOnlyList<string>>();
        foreach (var p in _pipelines)
        {
            try
            {
                var dto = await Api.GetPipelineAsync(p.Id);
                jobs[p.Id] = dto?.Stages.OrderBy(s => s.Order).Select(s => s.JobName)
                                        .Distinct(StringComparer.OrdinalIgnoreCase).ToArray()
                             ?? Array.Empty<string>();
            }
            catch { jobs[p.Id] = Array.Empty<string>(); }
        }
        _pipelineJobs = jobs;

        // Default to the pipeline that actually runs cicd-build, so the page opens on what it has
        // always shown; only fall back to "first active" when no pipeline contains it.
        var preferred = _pipelines.FirstOrDefault(p =>
                            _pipelineJobs.TryGetValue(p.Id, out var j)
                            && j.Contains(FallbackJob, StringComparer.OrdinalIgnoreCase))
                        ?? _pipelines.FirstOrDefault(p => p.IsActive)
                        ?? _pipelines.FirstOrDefault();

        SelectPipeline(preferred?.Id);
    }

    private void SelectPipeline(Guid? id)
    {
        _selectedPipelineId = id;
        _runs.Clear();
        _errors.Clear();

        _stageJobs = id is { } pid && _pipelineJobs.TryGetValue(pid, out var j) && j.Count > 0
            ? j
            : new[] { FallbackJob };

        // Open the first stage so the page has visible content on arrival; the rest stay collapsed
        // so a four-stage pipeline doesn't render four full tables at once.
        _expanded.Clear();
        if (_stageJobs.Count > 0) _expanded.Add(_stageJobs[0]);
    }

    private async Task OnPipelineSelectedAsync(Guid? id)
    {
        SelectPipeline(id);
        StateHasChanged();
        await RefreshAsync();
    }

    private void SetExpanded(string job, bool expanded)
    {
        if (expanded) _expanded.Add(job); else _expanded.Remove(job);
    }

    private async Task RefreshAsync()
    {
        _inflightCts?.Cancel();
        _inflightCts = new CancellationTokenSource();
        var ct = _inflightCts.Token;

        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            // Every stage in parallel: a pipeline has a handful of jobs, and loading them lazily on
            // panel expansion would leave the header counts blank until each panel is clicked.
            var fetches = _stageJobs.Select(async job =>
            {
                try
                {
                    return (job, builds: await Store.ListBuildsAsync(job, _count, ct), error: (string?)null);
                }
                catch (OperationCanceledException) { throw; }
                catch (Exception ex)
                {
                    return (job, builds: (IReadOnlyList<Build>)Array.Empty<Build>(), error: (string?)ex.Message);
                }
            });

            var results = await Task.WhenAll(fetches);
            _runs.Clear();
            _errors.Clear();
            foreach (var (job, builds, error) in results)
            {
                if (error is not null) _errors[job] = error;
                else _runs[job] = builds;
            }

            _lastFetchedAt = DateTimeOffset.UtcNow;
            _lastFetchedCount = _count;
        }
        catch (OperationCanceledException) { /* superseded — ignore */ }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ToggleAuto()
    {
        _autoOn = !_autoOn;
        if (_autoOn)
        {
            _timer ??= new Timer(_ => _ = InvokeAsync(RefreshAsync),
                null, Timeout.Infinite, Timeout.Infinite);
            _timer.Change(TimeSpan.FromSeconds(IntervalSec), TimeSpan.FromSeconds(IntervalSec));
        }
        else
        {
            _timer?.Change(Timeout.Infinite, Timeout.Infinite);
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _inflightCts?.Cancel();
        _inflightCts?.Dispose();
    }

    private IReadOnlyList<Build> VisibleRows(string job)
    {
        if (!_runs.TryGetValue(job, out var builds)) return Array.Empty<Build>();
        if (!HasFilter) return builds;
        return builds.Where(MatchesFilter).ToArray();
    }

    private bool MatchesFilter(Build b)
    {
        if (string.IsNullOrWhiteSpace(_filter)) return true;
        var f = _filter.Trim();
        return $"#{b.Number}".Contains(f, StringComparison.OrdinalIgnoreCase)
            || (b.Description?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false)
            || StatusLabel(b).Contains(f, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// The summary page defaults to cicd-build, so any other job must be named explicitly —
    /// otherwise the button would quietly open a different job's build of the same number.
    /// </summary>
    private static string DetailLinkFor(string jobName, Build b) =>
        string.Equals(jobName, FallbackJob, StringComparison.OrdinalIgnoreCase)
            ? $"/jenkins/builds/{b.Number}"
            : $"/jenkins/builds/{Uri.EscapeDataString(jobName)}/{b.Number}";

    /// <summary>
    /// Build URLs returned by Jenkins point at the docker network alias used by
    /// the WebUI's server-side client. Rewrite onto JenkinsOpts.BaseUrl so the
    /// browser can actually open them — matches what the Jenkins Admin link does.
    /// </summary>
    private string JenkinsLinkFor(string jobName, Build b)
    {
        var path = $"/job/{Uri.EscapeDataString(jobName)}/{b.Number}/";
        var baseUrl = JenkinsOpts.BaseUrl.TrimEnd('/');
        return $"{baseUrl}{path}";
    }

    private static string StatusLabel(Build b) =>
        b.Building ? "Running" : (b.Result?.ToString() ?? "Unknown");

    private static Color StatusColor(Build b)
    {
        if (b.Building) return Color.Info;
        return b.Result switch
        {
            BuildResult.Success  => Color.Success,
            BuildResult.Failure  => Color.Error,
            BuildResult.Unstable => Color.Warning,
            BuildResult.Aborted  => Color.Dark,
            _                    => Color.Default
        };
    }

    private static string FormatStarted(long unixMs)
    {
        if (unixMs <= 0) return "—";
        var t = DateTimeOffset.FromUnixTimeMilliseconds(unixMs);
        var ago = DateTimeOffset.UtcNow - t;
        return ago switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalHours: < 1 }   => $"{(int)ago.TotalMinutes}m ago",
            { TotalDays: < 1 }    => $"{(int)ago.TotalHours}h ago",
            { TotalDays: < 30 }   => $"{(int)ago.TotalDays}d ago",
            _                     => t.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
        };
    }

    private static string FormatDuration(Build b)
    {
        // For in-progress builds Jenkins reports duration=0; show "running" so the
        // column doesn't read "0.0s" and look misleading.
        if (b.Building) return "running…";
        if (b.Duration <= 0) return "—";
        var ts = TimeSpan.FromMilliseconds(b.Duration);
        return ts switch
        {
            { TotalSeconds: < 60 }  => $"{ts.TotalSeconds:F1}s",
            { TotalMinutes: < 60 }  => $"{(int)ts.TotalMinutes}m {ts.Seconds}s",
            _                       => $"{(int)ts.TotalHours}h {ts.Minutes}m"
        };
    }
}
